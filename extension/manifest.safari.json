{
  "exclude_permissions": [
    "downloads",
    "notifications"
  ],
  "background": {
    "scripts": ["common.js", "media.js", "downloads.js", "background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "overlay-style.js",
        "overlay.js",
        "links.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "17.0"
    }
  }
}
