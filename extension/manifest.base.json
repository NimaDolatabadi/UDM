{
  "manifest_version": 3,
  "name": "UDM Capture",
  "version": "0.0.0",
  "description": "Send downloads and streaming videos to UDM (Umbrella Download Manager).",
  "permissions": [
    "contextMenus",
    "cookies",
    "downloads",
    "nativeMessaging",
    "notifications",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "UDM Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "overlay-style.js",
        "overlay.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
